---
import Icon from '@/components/Icon.astro';
import { SITE, SOCIAL } from '@/data/site';
import { CURRENT, MISSION } from '@/data/profile';
import type { Locale } from '@/data/types';
import { path, useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const socials = [
  { label: t('social.github'), href: SOCIAL.github, icon: 'github' as const, external: true },
  { label: t('social.linkedin'), href: SOCIAL.linkedin, icon: 'linkedin' as const, external: true },
  { label: t('social.email'), href: SOCIAL.email, icon: 'mail' as const, external: false },
  { label: t('social.aida'), href: SOCIAL.aida, icon: 'globe' as const, external: true },
];
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="visually-hidden">{SITE.name}, {t('hero.line1')} {t('hero.line2')}</h1>

  <div class="hero__grid">
    <div class="hero__row hero__row--top">
      <p class="display hero__line hero__line--one" aria-hidden="true">{t('hero.line1')}</p>

      <div class="hero__cta">
        <a class="pill pill--solid" href={`${path('/', locale)}#ventures`}>{t('hero.cta')}</a>
        <a class="icon-btn" href={`${path('/', locale)}#ventures`} aria-label={t('hero.ctaAria')}>
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>

    <div class="hero__row hero__row--bottom">
      <p class="lede hero__lede">{MISSION[locale]}</p>

      <p class="display hero__line hero__line--two" aria-hidden="true">{t('hero.line2')}</p>
    </div>
  </div>

  <!-- The status block stays on the page's left edge; the links fill the
       space the second headline line leaves empty on the right. -->
  <div class="hero__foot">
    <div class="hero__status">
      <p class="hero__current mono">
        <span class="hero__dot" aria-hidden="true"></span>
        {CURRENT[locale]}
      </p>

      <p class="hero__place mono">{SITE.location[locale]}</p>

      <p>
        <a class="pill pill--ghost" href={SITE.cv[locale]} download>
          <Icon name="download" class="pill__icon" />
          {t('hero.cv')}
        </a>
      </p>
    </div>

    <ul class="hero__links">
      {
        socials.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              <Icon name={item.icon} size={15} />
              <span>{item.label}</span>
              <Icon name="arrow-up-right" size={14} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

</section>

<style>
  .hero {
    padding-block-start: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(1rem, 0.6rem + 1.6vw, 1.75rem);
  }

  .hero__line {
    color: var(--ink);
  }

  .hero__lede {
    max-width: 42ch;
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__foot {
    display: grid;
    gap: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem);
    margin-block-start: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    align-items: start;
  }

  .hero__status {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
  }

  .hero__current {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-dim);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .hero__dot {
    flex: none;
    translate: 0 -0.15em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero__place {
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .hero__status p:last-child {
    margin-block-start: 0.5rem;
  }

  /* The links read as a short list, matching the row lists further down the
     page rather than introducing a fifth kind of button. */
  .hero__links {
    display: grid;
    border-block-start: 1px solid var(--line);
  }

  .hero__links a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.15rem;
    border-block-end: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-dim);
    text-decoration: none;
    transition:
      color 160ms ease,
      padding-inline-start 160ms ease;
  }

  .hero__links a:hover {
    color: var(--ink);
    padding-inline-start: 0.5rem;
  }

  /* The label takes the slack so the trailing arrow sits on the right edge. */
  .hero__links span {
    flex: 1;
  }

  .hero__links a :global(svg):last-child {
    opacity: 0.4;
  }

  .hero__links a:hover :global(svg):last-child {
    opacity: 1;
  }

  /* Below the breakpoint the rows dissolve so the four pieces stack in a
     reading order that makes sense on a phone: both headline lines, then the
     description, then the call to action. */
  @media (max-width: 55.999rem) {
    .hero__row {
      display: contents;
    }

    .hero__line--one {
      order: 1;
    }

    .hero__line--two {
      order: 2;
    }

    .hero__lede {
      order: 3;
      margin-block-start: 0.5rem;
    }

    .hero__cta {
      order: 4;
    }
  }

  /* The reference layout: headline left with the call to action opposite it,
     then the description left with the second headline line dropping right. */
  @media (min-width: 56rem) {
    .hero__grid {
      gap: clamp(1.5rem, 0.8rem + 2.6vw, 3rem);
    }

    .hero__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    }

    .hero__row--bottom {
      align-items: flex-end;
    }

    /* Each line is a single unbroken statement, never re-wrapped by its column. */
    .hero__line {
      white-space: nowrap;
    }

    .hero__line--two {
      text-align: right;
    }

    .hero__lede {
      padding-block-end: 0.35rem;
    }

    .hero__foot {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
      column-gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    }
  }
</style>
