---
import Icon from '@/components/Icon.astro';
import { VENTURES } from '@/data/profile';
import type { Locale } from '@/data/types';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const [company, ...products] = VENTURES;
---

<section class="section" id="ventures" aria-labelledby="ventures-heading">
  <div class="section-head">
    <p class="eyebrow">{t('ventures.eyebrow')}</p>
    <p class="lede">
      {
        locale === 'fr'
          ? 'Je dirige AIDA, une entreprise d’IA fondée à Cotonou. Nous construisons deux produits : l’un écoute et parle les langues africaines, l’autre met de l’ordre dans les documents des institutions.'
          : 'I run AIDA, an AI company founded in Cotonou. We build two products: one that hears and speaks African languages, one that brings order to institutional documents.'
      }
    </p>
  </div>

  <h2 id="ventures-heading" class="display display--section section-title section-title--left">
    {t('ventures.label')}
  </h2>

  {
    company !== undefined && (
      <article class="venture venture--lead">
        <div class="venture__head">
          <h3 class="venture__name mono">{company.name}</h3>
          <span class="venture__role mono">{company.role[locale]}</span>
        </div>

        <p class="venture__summary">{company.summary[locale]}</p>

        <div class="venture__foot">
          <p class="tag-row">
            {company.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </p>

          <a class="pill" href={company.url} target="_blank" rel="noopener noreferrer">
            {company.domain}
            <Icon name="arrow-up-right" class="pill__icon" />
          </a>
        </div>
      </article>
    )
  }

  <div class="venture__products">
    {
      products.map((product) => (
        <article class="venture venture--product">
          <div class="venture__head">
            <h3 class="venture__name mono">{product.name}</h3>
            <span class="venture__role mono">{product.role[locale]}</span>
          </div>

          <p class="venture__summary">{product.summary[locale]}</p>

          <div class="venture__foot">
            <p class="tag-row">
              {product.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </p>

            <a class="pill" href={product.url} target="_blank" rel="noopener noreferrer">
              {product.domain}
              <Icon name="arrow-up-right" class="pill__icon" />
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .venture {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1.4vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--panel-raised);
    transition:
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .venture:hover {
    border-color: var(--line-strong);
    background: var(--panel-hover);
  }

  .venture--lead {
    margin-block-start: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--invert);
    color: var(--invert-ink);
    border-color: var(--invert);
  }

  .venture--lead:hover {
    background: #ffffff;
    border-color: #ffffff;
  }

  .venture--lead .venture__summary {
    color: rgba(10, 10, 11, 0.76);
    font-size: var(--step-1);
    max-width: 62ch;
  }

  .venture--lead .venture__role {
    background: var(--invert-ink);
    color: var(--invert);
    border-color: var(--invert-ink);
  }

  .venture--lead .pill {
    background: var(--invert-ink);
    color: var(--invert);
    border-color: var(--invert-ink);
  }

  .venture__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .venture__name {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .venture--lead .venture__name {
    font-size: var(--step-3);
  }

  .venture__role {
    padding: 0.22rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--step--2);
    color: var(--ink-dim);
  }

  .venture__summary {
    color: var(--ink-dim);
    font-size: var(--step-0);
    line-height: 1.65;
    max-width: 58ch;
  }

  .venture__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    margin-block-start: auto;
  }

  .venture__products {
    display: grid;
    gap: 0.85rem;
    margin-block-start: 0.85rem;
  }

  @media (min-width: 52rem) {
    .venture__products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
