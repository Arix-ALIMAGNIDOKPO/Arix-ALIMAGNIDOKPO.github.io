---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import aidaLogo from '@/assets/logos/aida.png';
import ayokaLogo from '@/assets/logos/ayoka.png';
import sovreanLogo from '@/assets/logos/sovrean.png';
import { COMPANY } from '@/data/profile';
import type { Locale, LogoName } from '@/data/types';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const LOGOS: Record<LogoName, ImageMetadata> = {
  aida: aidaLogo,
  ayoka: ayokaLogo,
  sovrean: sovreanLogo,
};
---

<section class="section" id="ventures" aria-labelledby="ventures-heading">
  <SectionHead
    eyebrow={t('ventures.eyebrow')}
    lede={t('ventures.lead')}
    title={t('ventures.label')}
    headingId="ventures-heading"
  />

  <!-- The company reads as an editorial masthead rather than another card. -->
  <div class="company">
    <div class="company__body">
      <p class="company__fullname mono">{COMPANY.fullName}</p>
      <p class="company__summary">{COMPANY.summary[locale]}</p>

      <dl class="company__facts mono">
        <div>
          <dt>{t('ventures.founded')}</dt>
          <dd class="tabular">{COMPANY.founded}</dd>
        </div>
        <div>
          <dt>{t('ventures.based')}</dt>
          <dd>{COMPANY.city[locale]}</dd>
        </div>
        <div>
          <dt>{t('ventures.products')}</dt>
          <dd>{COMPANY.products.map((product) => product.name).join(', ')}</dd>
        </div>
      </dl>

      <p>
        <a class="pill pill--solid" href={COMPANY.url} target="_blank" rel="noopener noreferrer">
          {COMPANY.domain}
          <Icon name="arrow-up-right" class="pill__icon" />
        </a>
      </p>
    </div>
  </div>

  <ul class="products">
    {
      COMPANY.products.map((product) => (
        <li class:list={['product', `product--${product.logo}`]}>
          <div class="product__head">
            <span class="logo-plate product__logo">
              <Image
                src={LOGOS[product.logo]}
                alt={`${product.name} ${t('ventures.logoAlt')}`}
                widths={[160, 320]}
                sizes="120px"
                loading="lazy"
              />
            </span>
            <div>
              <h3 class="product__name mono">{product.name}</h3>
              <p class="product__tagline">{product.tagline[locale]}</p>
            </div>
          </div>

          <p class="product__summary">{product.summary[locale]}</p>

          <ul class="product__capabilities mono">
            {product.capabilities[locale].map((capability) => (
              <li>{capability}</li>
            ))}
          </ul>

          <dl class="product__facts mono">
            {product.facts.map((fact) => (
              <div>
                <dt>{fact.label[locale]}</dt>
                <dd>{fact.value[locale]}</dd>
              </div>
            ))}
          </dl>

          <p class="product__cta">
            <a class="pill" href={product.url} target="_blank" rel="noopener noreferrer">
              {product.domain}
              <Icon name="arrow-up-right" class="pill__icon" />
            </a>
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* ---------- the company ---------- */

  .company {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.6vw, 2.5rem);
    margin-block-start: clamp(1.25rem, 1rem + 1.6vw, 2.25rem);
    padding-block-start: clamp(1.25rem, 1rem + 1.6vw, 2rem);
    border-block-start: 2px solid var(--ink);
  }




  .company__body {
    display: grid;
    gap: 1.1rem;
    max-width: 66ch;
  }

  .company__fullname {
    font-size: var(--step--1);
    color: var(--ink-muted);
    letter-spacing: 0.01em;
  }

  .company__summary {
    font-size: var(--step-2);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .company__facts {
    display: grid;
    gap: 0.6rem 2rem;
    font-size: var(--step--2);
  }

  .company__facts > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.4rem;
    border-block-start: 1px solid var(--line);
  }

  .company__facts dt {
    color: var(--ink-faint);
  }

  .company__facts dd {
    margin: 0;
    color: var(--ink-dim);
  }


  /* ---------- the products ---------- */

  .products {
    display: grid;
    gap: clamp(0.85rem, 0.7rem + 0.7vw, 1.25rem);
    margin-block-start: clamp(1.75rem, 1.4rem + 1.8vw, 3rem);
  }

  .product {
    position: relative;
    display: grid;
    gap: 1.1rem;
    align-content: start;
    padding: clamp(1.15rem, 0.95rem + 1.1vw, 2rem);
    background: var(--panel-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition:
      border-color 220ms ease,
      background-color 220ms ease;
  }

  /* Brand accent as a rule along the top edge plus a soft bloom behind it. */
  .product::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 3px;
    background: var(--product-accent);
  }

  .product::after {
    content: '';
    position: absolute;
    inset-block-start: -6rem;
    inset-inline-end: -6rem;
    width: 16rem;
    height: 16rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--product-accent), transparent 70%);
    opacity: 0.14;
    pointer-events: none;
  }

  .product:hover {
    border-color: var(--line-strong);
    background: var(--panel-hover);
  }

  .product--ayoka {
    --product-accent: #2b3a8f;
  }

  .product--sovrean {
    --product-accent: #d81f6a;
  }

  .product__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
  }

  .product__logo {
    --logo-height: 1.75rem;
    padding: 0.75rem 1rem;
    flex: none;
  }

  .product__name {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .product__tagline {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .product__summary {
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--ink-dim);
    max-width: 54ch;
  }

  .product__capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: var(--step--2);
  }

  .product__capabilities li {
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--ink-muted);
  }

  .product__facts {
    display: grid;
    font-size: var(--step--2);
    border-block-start: 1px solid var(--line);
  }

  .product__facts > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--line);
  }

  .product__facts dt {
    color: var(--ink-faint);
  }

  .product__facts dd {
    margin: 0;
    color: var(--ink-dim);
  }

  .product__cta {
    margin-block-start: auto;
  }

  @media (min-width: 30rem) {
    .product__facts > div {
      grid-template-columns: 8rem minmax(0, 1fr);
    }
  }

  @media (min-width: 58rem) {
    .products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
