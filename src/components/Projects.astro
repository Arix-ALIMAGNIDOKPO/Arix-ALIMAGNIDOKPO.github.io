---
import Icon from '@/components/Icon.astro';
import { PROJECTS } from '@/data/profile';
import { SOCIAL } from '@/data/site';
import type { Locale } from '@/data/types';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = [...PROJECTS].sort((a, b) => Number(b.year) - Number(a.year));
---

<section class="section" id="projects" aria-labelledby="projects-heading">
  <div class="section-head">
    <p class="eyebrow">{t('projects.eyebrow')}</p>
    <div>
      <h2 id="projects-heading" class="projects__heading mono">{t('projects.label')}</h2>
      <p class="lede">
        {
          locale === 'fr'
            ? 'Des projets construits pour être utilisés, pas seulement pour être rendus.'
            : 'Projects built to be used, not just submitted.'
        }
      </p>
    </div>
  </div>

  <ul class="projects__grid">
    {
      projects.map((project) => (
        <li class:list={['card', 'projects__item', project.repo !== undefined && 'card--link']}>
          <p class="projects__meta mono">
            <span class="tabular">{project.year}</span>
            {project.repo === undefined && <span class="projects__private">{t('projects.noRepo')}</span>}
          </p>

          <h3 class="projects__title">
            {project.repo !== undefined ? (
              <a href={project.repo} target="_blank" rel="noopener noreferrer">
                <span class="projects__stretch">{project.name[locale]}</span>
              </a>
            ) : (
              project.name[locale]
            )}
          </h3>

          <p class="projects__summary">{project.summary[locale]}</p>

          <p class="tag-row">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </p>
        </li>
      ))
    }
  </ul>

  <p class="projects__all">
    <a class="pill" href={SOCIAL.github} target="_blank" rel="noopener noreferrer">
      <Icon name="github" class="pill__icon" />
      github.com/Arix-ALIMAGNIDOKPO
      <Icon name="arrow-up-right" class="pill__icon" />
    </a>
  </p>
</section>

<style>
  .projects__heading {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    margin-block-end: 0.75rem;
  }

  .projects__grid {
    display: grid;
    gap: 0.85rem;
    margin-block-start: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
  }

  .projects__item {
    position: relative;
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .projects__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .projects__private {
    color: var(--ink-faint);
  }

  .projects__title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .projects__title a {
    text-decoration: none;
  }

  .projects__stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .projects__summary {
    font-size: var(--step--1);
    color: var(--ink-dim);
    line-height: 1.6;
  }

  .projects__all {
    margin-block-start: 1.5rem;
  }

  @media (min-width: 44rem) {
    .projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .projects__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
