---
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import { PROJECTS } from '@/data/profile';
import { SOCIAL } from '@/data/site';
import type { Locale } from '@/data/types';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** No project is singled out: newest first, every row the same weight. */
const projects = [...PROJECTS].sort((a, b) => Number(b.year) - Number(a.year));

const languageSlug = (language: string): string =>
  language
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<section class="section" id="projects" aria-labelledby="projects-heading">
  <SectionHead
    lede={t('projects.lead')}
    title={t('projects.label')}
    headingId="projects-heading"
  />

  <ol class="rows">
    {
      projects.map((project) => {
        const aside = (
          <p class="row__aside">
            <span class="tabular">{project.year}</span>
            <span class:list={['lang', `lang--${languageSlug(project.language)}`]}>
              <span class="lang__dot" aria-hidden="true" />
              {project.language}
            </span>
          </p>
        );

        const main = (
          <div class="row__main">
            <h3 class="row__title">{project.name[locale]}</h3>
            <p class="row__context">{project.outcome[locale]}</p>
            <p class="row__text">{project.summary[locale]}</p>
          </div>
        );

        return (
          <li class="row">
            {project.repo === undefined ? (
              <div class="row__inner">
                {aside}
                {main}
                <span class="repo__private mono">{t('projects.noRepo')}</span>
              </div>
            ) : (
              <a class="row__inner row__inner--link" href={project.repo} target="_blank" rel="noopener noreferrer">
                {aside}
                {main}
                <span class="row__go" aria-hidden="true">
                  <Icon name="arrow-up-right" size={15} />
                </span>
              </a>
            )}
          </li>
        );
      })
    }
  </ol>

  <p class="repos__all">
    <a class="pill" href={SOCIAL.github} target="_blank" rel="noopener noreferrer">
      <Icon name="github" class="pill__icon" />
      {t('projects.more')}
      <Icon name="arrow-up-right" class="pill__icon" />
    </a>
  </p>
</section>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .lang__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--lang-colour, var(--ink-faint));
    flex: none;
  }

  .lang--python {
    --lang-colour: #3572a5;
  }

  .lang--typescript {
    --lang-colour: #3178c6;
  }

  .lang--jupyter-notebook {
    --lang-colour: #da5b0b;
  }

  .repo__private {
    font-size: var(--step--2);
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .repos__all {
    margin-block-start: 1.5rem;
  }
</style>
