---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE } from '@/data/site';
import type { Locale } from '@/data/types';
import { alternateUrl, otherLocale, path, useTranslations } from '@/i18n/utils';
import type { UIKey } from '@/i18n/ui';

interface Props {
  locale: Locale;
  compact?: boolean;
  /** Where the language toggle points; see BaseLayout's `alternatePath`. */
  alternateHref?: string;
}

const { locale, compact = false, alternateHref } = Astro.props;
const t = useTranslations(locale);

const home = path('/', locale);
const other = otherLocale(locale);

/** Section anchors resolve against the homepage, so the nav works from any page. */
const links: { key: UIKey; href: string }[] = [
  { key: 'nav.about', href: `${home}#about` },
  { key: 'nav.work', href: `${home}#work` },
  { key: 'nav.education', href: `${home}#education` },
  { key: 'nav.ventures', href: `${home}#ventures` },
  { key: 'nav.articles', href: path('/articles/', locale) },
  { key: 'nav.contact', href: `${home}#contact` },
];

const current = Astro.url.pathname;
const isCurrent = (href: string): boolean => href === current;
---

<header class="masthead no-print">
  <a class="masthead__name mono" href={home} aria-label={t('nav.home')}>
    <span>{SITE.firstName}</span>
    <span>{SITE.lastName}</span>
  </a>

  <div class="masthead__tools">
    <ThemeToggle locale={locale} />

    <div class="langs" role="group" aria-label={t('lang.switch')}>
      <span class="langs__item is-active mono" aria-current="true">
        {t(locale === 'en' ? 'lang.en' : 'lang.fr')}
      </span>
      <a
        class="langs__item mono"
        href={alternateHref ?? alternateUrl(Astro.url, other)}
        hreflang={other}
        lang={other}
        rel="alternate"
        title={t(other === 'fr' ? 'lang.toFrench' : 'lang.toEnglish')}
      >
        {t(other === 'en' ? 'lang.en' : 'lang.fr')}
      </a>
    </div>

    {
      !compact && (
        <button
          class="burger mono"
          type="button"
          data-nav-toggle
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label={t('nav.menu')}
        >
          <span class="burger__bars" aria-hidden="true">
            <span />
            <span />
          </span>
          <span class="burger__label">{t('nav.menu')}</span>
        </button>
      )
    }
  </div>

  {
    !compact && (
      <nav class="masthead__nav" id="site-nav" aria-label={t('nav.menu')}>
        <ul>
          {links.map(({ key, href }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {t(key)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

<script>
  /**
   * Progressive enhancement: the nav ships visible, and this collapses it into
   * a menu only on narrow screens where a button exists to reopen it. With no
   * JavaScript the full list stays on the page.
   */
  const nav = document.getElementById('site-nav');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  if (nav && toggle) {
    const wide = window.matchMedia('(min-width: 58rem)');
    const isOpen = (): boolean => toggle.getAttribute('aria-expanded') === 'true';

    const sync = (): void => {
      if (wide.matches) {
        nav.hidden = false;
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        nav.hidden = !isOpen();
      }
    };

    const setOpen = (open: boolean): void => {
      toggle.setAttribute('aria-expanded', String(open));
      sync();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Following a link, pressing Escape, or clicking away all close the menu.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen() && !wide.matches) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (wide.matches || !isOpen()) return;
      const target = event.target as Node;
      if (!nav.contains(target) && !toggle.contains(target)) setOpen(false);
    });

    wide.addEventListener('change', sync);
    sync();
  }

  /**
   * The header gets out of the way going down the page and comes back on the
   * way up, so reading is uninterrupted but navigation is always one small
   * upward scroll away.
   */
  const header = document.querySelector<HTMLElement>('.masthead');

  if (header) {
    /** Movement below this is jitter or a trackpad tremor, not intent. */
    const THRESHOLD = 6;
    /** Near the top the header is always shown, whatever the direction. */
    const ALWAYS_SHOWN = 72;

    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    const menuOpen = (): boolean =>
      document.querySelector('[data-nav-toggle]')?.getAttribute('aria-expanded') === 'true';

    let lastY = window.scrollY;
    let pending = false;

    const reveal = (): void => header.removeAttribute('data-hidden');

    const update = (): void => {
      pending = false;
      const y = Math.max(window.scrollY, 0);
      const delta = y - lastY;

      if (y <= ALWAYS_SHOWN) {
        header.removeAttribute('data-stuck');
        reveal();
        lastY = y;
        return;
      }

      header.setAttribute('data-stuck', '');

      // Someone who asked for less motion keeps a header that never moves.
      if (calm.matches) {
        reveal();
        lastY = y;
        return;
      }

      if (Math.abs(delta) < THRESHOLD) return;

      if (delta > 0 && !menuOpen()) header.setAttribute('data-hidden', '');
      else reveal();

      lastY = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );

    // Never leave a keyboard user tabbing into a header they cannot see.
    header.addEventListener('focusin', reveal);
    calm.addEventListener('change', update);
    update();
  }
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1.25rem;
    /* Bleeds to the panel edges so the blur covers the full width, then pulls
       its own gutter back in. */
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-block: clamp(0.75rem, 0.6rem + 0.7vw, 1.1rem);
    background: color-mix(in srgb, var(--panel) 88%, transparent);
    backdrop-filter: blur(10px);
    border-block-end: 1px solid transparent;
    transition:
      translate 260ms ease,
      border-color 200ms ease;
  }

  /* Slid out of view on the way down; the panel's clip hides it. */
  .masthead[data-hidden] {
    translate: 0 -100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead {
      transition: none;
    }
  }

  /* The rule only appears once the page has moved, so it does not draw a line
     across the top of the hero at rest. */
  .masthead[data-stuck] {
    border-block-end-color: var(--line);
  }

  .masthead__name {
    display: grid;
    font-size: var(--step--1);
    line-height: 1.35;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .masthead__name:hover span:last-child {
    color: var(--ink-muted);
  }

  .masthead__tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* ---------- the menu button ---------- */

  .burger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem 0.4rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--panel-raised);
    color: var(--ink);
    font-size: var(--step--2);
  }

  .burger__bars {
    display: grid;
    gap: 4px;
    width: 14px;
  }

  .burger__bars span {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition:
      translate 200ms ease,
      rotate 200ms ease;
  }

  .burger[aria-expanded='true'] .burger__bars span:first-child {
    translate: 0 2.75px;
    rotate: 45deg;
  }

  .burger[aria-expanded='true'] .burger__bars span:last-child {
    translate: 0 -2.75px;
    rotate: -45deg;
  }

  /* ---------- the nav itself ---------- */

  .masthead__nav {
    grid-column: 1 / -1;
    grid-row: 2;
    max-height: calc(100svh - 8rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .masthead__nav ul {
    display: grid;
    border-block-start: 1px solid var(--line);
  }

  .masthead__nav a {
    display: block;
    padding: 0.85rem 0.25rem;
    border-block-end: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--ink-dim);
    text-decoration: none;
    transition:
      color 160ms ease,
      padding-inline-start 160ms ease;
  }

  .masthead__nav a:hover {
    color: var(--ink);
    padding-inline-start: 0.6rem;
  }

  .masthead__nav a[aria-current='page'] {
    color: var(--ink);
  }


  /* A segmented control rather than two stacked 15px links: every language is
     a proper tap target on a phone. */
  .langs {
    display: flex;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--panel-raised);
  }

  .langs__item {
    display: grid;
    place-items: center;
    min-width: 2rem;
    min-height: 1.85rem;
    padding-inline: 0.5rem;
    border-radius: var(--radius-pill);
    font-size: var(--step--2);
    line-height: 1;
    color: var(--ink-faint);
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .langs__item.is-active {
    background: var(--invert);
    color: var(--invert-ink);
  }

  .langs__item:not(.is-active):hover {
    color: var(--ink);
  }

  /* ---------- from tablet up: inline pills, no button ---------- */

  @media (min-width: 58rem) {
    .masthead {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .burger {
      display: none;
    }

    .masthead__nav {
      grid-column: 2;
      grid-row: 1;
      max-height: none;
      overflow: visible;
    }

    .masthead__nav ul {
      display: flex;
      gap: 0.3rem;
      border-block-start: 0;
    }

    .masthead__nav a {
      display: block;
      padding: 0.4rem 0.75rem;
      border-block-end: 0;
      border: 1px solid transparent;
      border-radius: var(--radius-pill);
      font-size: var(--step--1);
      color: var(--ink-muted);
      white-space: nowrap;
    }

    .masthead__nav a:hover {
      padding-inline-start: 0.75rem;
      background: var(--panel-raised);
      border-color: var(--line);
      color: var(--ink);
    }

    .masthead__nav a[aria-current='page'] {
      border-color: var(--line-strong);
    }


    .masthead__tools {
      justify-content: flex-end;
    }
  }
</style>
