---
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import { RESEARCH } from '@/data/profile';
import type { Locale } from '@/data/types';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section" id="research" aria-labelledby="research-heading">
  <SectionHead
    lede={t('research.lead')}
    title={t('research.label')}
    headingId="research-heading"
  />

  <ol class="rows">
    {
      RESEARCH.map((item) => (
        <li class="row">
          <div class="row__inner">
            <p class="row__aside">{item.period[locale]}</p>

            <div class="row__main">
              <h3 class="row__title">{item.title[locale]}</h3>
              <p class="row__context">{item.context[locale]}</p>
              <p class="row__text">{item.summary[locale]}</p>

              {item.highlights[locale].length > 0 && (
                <ul class="row__notes">
                  {item.highlights[locale].map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}

              {item.links !== undefined && (
                <p class="row__links">
                  {item.links.map((link) => (
                    <a class="pill" href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label}
                      <Icon name="arrow-up-right" class="pill__icon" />
                    </a>
                  ))}
                </p>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>
