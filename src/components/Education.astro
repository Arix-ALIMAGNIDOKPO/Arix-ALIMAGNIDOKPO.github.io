---
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import { EDUCATION } from '@/data/profile';
import type { Locale } from '@/data/types';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section" id="education" aria-labelledby="education-heading">
  <SectionHead
    eyebrow={t('education.eyebrow')}
    lede={t('education.lead')}
    title={t('education.label')}
    headingId="education-heading"
  />

  <ol class="edu">
    {
      EDUCATION.map((study) => (
        <li class:list={['edu__item', study.current === true && 'edu__item--current']}>
          <div class="edu__when">
            <p class="edu__period mono tabular">{study.period[locale]}</p>
            {study.current === true && <p class="chip chip--accent edu__now mono">{t('education.current')}</p>}
          </div>

          <div class="edu__what">
            <h3 class="edu__degree">{study.degree[locale]}</h3>

            <p class="edu__school mono">
              {study.schoolUrl !== undefined ? (
                <a href={study.schoolUrl} target="_blank" rel="noopener noreferrer">
                  {study.school}
                  <Icon name="arrow-up-right" size={12} />
                </a>
              ) : (
                study.school
              )}
            </p>

            <p class="edu__place mono">
              {study.place}
              {study.grade !== undefined && (
                <>
                  <span class="edu__sep" aria-hidden="true">
                    ·
                  </span>
                  <span class="edu__grade">{study.grade[locale]}</span>
                </>
              )}
            </p>

            {study.notes[locale].length > 0 && (
              <ul class="edu__notes">
                {study.notes[locale].map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .edu {
    margin-block-start: clamp(1.25rem, 1rem + 1.4vw, 2.25rem);
    border-block-start: 1px solid var(--line);
  }

  .edu__item {
    display: grid;
    gap: 0.6rem;
    padding-block: clamp(1.1rem, 0.95rem + 0.7vw, 1.75rem);
    border-block-end: 1px solid var(--line);
  }


  .edu__when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .edu__period {
    font-size: var(--step--2);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .edu__now {
    padding-block: 0.15rem;
  }

  .edu__what {
    display: grid;
    gap: 0.35rem;
  }

  .edu__degree {
    font-size: var(--step-1);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }


  .edu__school {
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .edu__school a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
  }

  .edu__school a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .edu__place {
    font-size: var(--step--2);
    color: var(--ink-muted);
  }

  .edu__sep {
    margin-inline: 0.4rem;
    color: var(--ink-faint);
  }

  .edu__grade {
    color: var(--accent);
  }

  .edu__notes {
    display: grid;
    gap: 0.4rem;
    margin-block-start: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-dim);
    line-height: 1.6;
    max-width: 68ch;
  }

  .edu__notes li {
    position: relative;
    padding-inline-start: 1rem;
  }

  .edu__notes li::before {
    content: '\203a';
    position: absolute;
    inset-inline-start: 0;
    color: var(--ink-faint);
  }

  @media (min-width: 48rem) {
    .edu__item {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1.75rem;
      align-items: start;
    }

    .edu__when {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
