---
/**
 * The single heading pattern every section uses: the oversized title, then one
 * sentence underneath, both starting on the same left edge as the rows below.
 *
 * That shared edge is the point. Title, sentence and every row in the section
 * line up on one vertical, so the page reads as a single column of content
 * rather than a series of differently aligned blocks.
 *
 * Every section goes through this component so none can drift into its own
 * format. If the rhythm needs to change, it changes here once.
 */
interface Props {
  /** One sentence. Not a paragraph. Omit it where the title says enough. */
  lede?: string;
  /** The oversized title. */
  title: string;
  /** Id for the <h2>, referenced by the section's aria-labelledby. */
  headingId: string;
}

const { lede, title, headingId } = Astro.props;
---

<header class="head">
  <h2 id={headingId} class="display display--section head__title">{title}</h2>
  {lede !== undefined && <p class="lede head__lede">{lede}</p>}
</header>

<style>
  .head {
    display: grid;
    justify-items: start;
  }

  .head__lede {
    margin-block-start: clamp(0.75rem, 0.6rem + 0.7vw, 1.25rem);
    max-width: 54ch;
  }
</style>
