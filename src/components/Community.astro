---
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import { COMMUNITY } from '@/data/profile';
import type { Locale } from '@/data/types';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Ongoing commitments lead; the order inside each group is the authored one. */
const groups = [
  { key: 'ongoing' as const, label: t('community.ongoing'), items: COMMUNITY.filter((i) => i.ongoing === true) },
  { key: 'past' as const, label: t('community.past'), items: COMMUNITY.filter((i) => i.ongoing !== true) },
].filter((group) => group.items.length > 0);
---

<section class="section" id="community" aria-labelledby="community-heading">
  <SectionHead title={t('community.label')} headingId="community-heading" />

  {
    groups.map((group) => (
      <div class="com__group">
        <h3 class="com__label mono">
          {group.key === 'ongoing' && <span class="com__dot" aria-hidden="true" />}
          {group.label}
        </h3>

        <ul class="rows com__rows">
          {group.items.map((item) => {
            const aside = <p class="row__aside">{item.period[locale]}</p>;
            const main = (
              <div class="row__main">
                <h4 class="row__title">{item.role[locale]}</h4>
                <p class="row__context">{item.org[locale]}</p>
                <p class="row__text">{item.detail[locale]}</p>
              </div>
            );

            return (
              <li class="row">
                {item.orgUrl === undefined ? (
                  <div class="row__inner">
                    {aside}
                    {main}
                  </div>
                ) : (
                  <a class="row__inner row__inner--link" href={item.orgUrl} target="_blank" rel="noopener noreferrer">
                    {aside}
                    {main}
                    <span class="row__go" aria-hidden="true">
                      <Icon name="arrow-up-right" size={15} />
                    </span>
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .com__group + .com__group {
    margin-block-start: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem);
  }

  .com__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: clamp(1.25rem, 1rem + 1.4vw, 2.25rem);
    font-size: var(--step--2);
    color: var(--ink-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .com__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .com__rows {
    margin-block-start: 0.75rem;
  }
</style>
