---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import portrait from '@/assets/photos/portrait.jpg';
import { INTRO, RESEARCH_AREAS, SKILLS } from '@/data/profile';
import { SITE } from '@/data/site';
import type { Locale } from '@/data/types';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section" id="about" aria-labelledby="about-heading">
  <h2 id="about-heading" class="visually-hidden">{t('nav.about')}</h2>

  <div class="section-head">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <div>
      <p class="lede about__intro">{INTRO[locale]}</p>
      <ul class="about__areas">
        {RESEARCH_AREAS[locale].map((area) => <li class="chip">{area}</li>)}
      </ul>
    </div>
  </div>

  <div class="about__body">
    <div class="about__skills">
      {
        SKILLS.map((group) => (
          <article class:list={['card', 'about__skill', group.emphasis === 'primary' && 'card--invert']}>
            <h3 class="about__skill-title mono">{group.label[locale]}</h3>
            <p class="tag-row">
              {group.items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </p>
          </article>
        ))
      }

      <p class="about__note">
        <span class="mono">{t('about.skillsNote')}</span>
        <span class="icon-btn icon-btn--solid about__badge" aria-hidden="true">
          <Icon name="arrow-up-right" />
        </span>
      </p>
    </div>

    <figure class="about__portrait">
      <Image
        src={portrait}
        alt={t('about.portraitAlt')}
        widths={[380, 760]}
        sizes="(min-width: 62rem) 22rem, 70vw"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="mono">{SITE.location[locale]}</figcaption>
    </figure>
  </div>
</section>

<style>
  .about__intro {
    max-width: 52ch;
  }

  .about__areas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 1.25rem;
  }

  .about__body {
    display: grid;
    gap: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    margin-block-start: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    align-items: start;
  }

  .about__skills {
    display: grid;
    gap: 0.85rem;
  }

  /* Cards step inward as they descend, echoing the reference layout.
     Driven by nth-child rather than an inline style attribute, so the page
     needs no `unsafe-inline` in its style-src. */
  .about__skill {
    margin-inline-start: 0;
  }

  @media (min-width: 40rem) {
    .about__skill:nth-child(2) {
      margin-inline-start: 1rem;
    }

    .about__skill:nth-child(3) {
      margin-inline-start: 2rem;
    }

    .about__skill:nth-child(4) {
      margin-inline-start: 3rem;
    }
  }

  .about__skill-title {
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-block-end: 0.6rem;
  }

  .about__note {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block-start: 0.5rem;
    font-size: var(--step--2);
    color: var(--ink-muted);
    max-width: 34ch;
  }

  .about__badge {
    flex: none;
  }

  .about__portrait {
    margin: 0;
  }

  .about__portrait :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 22%;
    border-radius: var(--radius-card);
    filter: grayscale(1) contrast(1.06);
    transition: filter 400ms ease;
  }

  .about__portrait:hover :global(img) {
    filter: grayscale(0) contrast(1);
  }

  .about__portrait figcaption {
    margin-block-start: 0.75rem;
    font-size: var(--step--2);
    color: var(--ink-muted);
    text-align: right;
  }

  @media (min-width: 62rem) {
    .about__body {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    }

    .about__note {
      margin-block-start: 1.5rem;
    }
  }
</style>
